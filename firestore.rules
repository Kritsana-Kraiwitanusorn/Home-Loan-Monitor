rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Common helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Rules for loan contracts
    match /contracts/{contractId} {
      allow read, list: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() 
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.nickname is string
        && request.resource.data.bankName is string
        && request.resource.data.loanAmount is number
        && request.resource.data.loanAmount > 0
        && request.resource.data.totalMonths is number
        && request.resource.data.totalMonths > 0
        && request.resource.data.dueDay is number
        && request.resource.data.dueDay >= 1
        && request.resource.data.dueDay <= 31
        && request.resource.data.status in ['Active', 'Closed', 'Refinanced']
        && (!('sortOrder' in request.resource.data) || request.resource.data.sortOrder is number);

      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.nickname is string
        && request.resource.data.bankName is string
        && request.resource.data.status in ['Active', 'Closed', 'Refinanced']
        && (!('sortOrder' in request.resource.data) || request.resource.data.sortOrder is number);

      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Rules for payment records
    match /payments/{paymentId} {
      allow read, list: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.contractId is string
        && request.resource.data.installmentIndex is number
        && request.resource.data.paymentDate is string
        && request.resource.data.scheduledAmount is number
        && request.resource.data.extraAmount is number
        && request.resource.data.totalPaid is number;

      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.contractId == resource.data.contractId;

      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Rules for custom settings
    match /settings/{userId} {
      allow read, get: if isSignedIn() && userId == request.auth.uid;
      
      allow create, update: if isSignedIn()
        && userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.houseNumber is string;
        
      allow delete: if isSignedIn() && userId == request.auth.uid;
    }
  }
}
